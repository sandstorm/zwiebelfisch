#!/usr/bin/env node
//MISE description="Write the simple demo example's draw.io diagram (diagrams/editor.drawio.png): the picture drawn by the Typst CLI, the same boxes and arrows as diagrams.net XML inside"
//MISE sources=["mise-tasks/fixtures/demo-diagram", "src/extensions/diagrams/model/png.ts", "docs/fonts/Gabarito-Regular.ttf"]
//MISE outputs=["demo/examples/simple/diagrams/editor.drawio.png"]
// A .drawio.png is a PNG with the diagram's XML in a tEXt chunk (src/extensions/diagrams/model/png.ts). diagrams.net
// cannot run here, so this draws the picture with the Typst CLI and embeds the XML of the same boxes and arrows: the
// example shows the picture, and diagrams.net opens the diagram (and redraws the picture on the first change).
// 1 diagrams.net unit = 1pt, drawn at 144 ppi (a 2× picture, as diagrams.net exports for screens).
import { execFileSync } from 'node:child_process';
import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { writeDiagramXml } from '../../src/extensions/diagrams/model/png.ts';

const OUT = new URL('../../demo/examples/simple/diagrams/editor.drawio.png', import.meta.url);
const SIZE = { width: 560, height: 90 };
const BOX = { width: 120, height: 50 };
const BOXES = [
  { id: 'visual', label: 'Visual editor', x: 20, y: 20, fill: '#dae8fc', stroke: '#6c8ebf' },
  { id: 'source', label: 'Typst source', x: 220, y: 20, fill: '#fff2cc', stroke: '#d6b656' },
  { id: 'preview', label: 'Preview', x: 420, y: 20, fill: '#d5e8d4', stroke: '#82b366' },
];
const ARROWS = [
  { id: 'writes', label: 'writes', from: 'visual', to: 'source' },
  { id: 'compiles', label: 'compiles', from: 'source', to: 'preview' },
];

const box = (id) => BOXES.find((b) => b.id === id);

/** The picture as Typst: rounded boxes, arrows from the right side of one box to the left of the next, labels on them. */
function typst() {
  const pt = (n) => `${n}pt`;
  const boxes = BOXES.map(({ label, x, y, fill, stroke }) =>
    `#place(dx: ${pt(x)}, dy: ${pt(y)}, rect(width: ${pt(BOX.width)}, height: ${pt(BOX.height)}, radius: 5pt, `
    + `fill: rgb("${fill}"), stroke: 1pt + rgb("${stroke}"), align(center + horizon)[${label}]))`);
  const arrows = ARROWS.map(({ label, from, to }) => {
    const [x1, x2, y] = [box(from).x + BOX.width, box(to).x, box(from).y + BOX.height / 2];
    return [
      `#place(dx: ${pt(x1)}, dy: ${pt(y)}, line(length: ${pt(x2 - x1 - 6)}, stroke: 1pt))`,
      `#place(dx: ${pt(x2 - 8)}, dy: ${pt(y - 4)}, polygon(fill: black, (0pt, 0pt), (8pt, 4pt), (0pt, 8pt)))`,
      `#place(dx: ${pt(x1)}, dy: ${pt(y - 10)}, box(width: ${pt(x2 - x1)}, height: 20pt, `
      + `align(center + horizon, box(fill: white, inset: (x: 2pt), text(size: 10pt)[${label}]))))`,
    ].join('\n');
  });
  return [
    `#set page(width: ${pt(SIZE.width)}, height: ${pt(SIZE.height)}, margin: 0pt, fill: white)`,
    '#set text(font: "Gabarito", size: 12pt)',
    ...boxes,
    ...arrows,
  ].join('\n');
}

/** The same diagram as diagrams.net stores it. */
function xml() {
  const boxes = BOXES.map(({ id, label, x, y, fill, stroke }) =>
    `<mxCell id="${id}" value="${label}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=${fill};strokeColor=${stroke};fontSize=12;" vertex="1" parent="1">`
    + `<mxGeometry x="${x}" y="${y}" width="${BOX.width}" height="${BOX.height}" as="geometry"/></mxCell>`);
  const arrows = ARROWS.map(({ id, label, from, to }) =>
    `<mxCell id="${id}" value="${label}" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="${from}" target="${to}">`
    + '<mxGeometry relative="1" as="geometry"/></mxCell>');
  return '<mxfile><diagram id="editor" name="Page-1"><mxGraphModel grid="1" gridSize="10" page="0"><root>'
    + '<mxCell id="0"/><mxCell id="1" parent="0"/>'
    + [...boxes, ...arrows].join('')
    + '</root></mxGraphModel></diagram></mxfile>';
}

const dir = mkdtempSync(join(tmpdir(), 'demo-diagram-'));
try {
  const png = join(dir, 'picture.png');
  const fonts = new URL('../../docs/fonts/', import.meta.url).pathname;
  execFileSync('typst', ['compile', '--format', 'png', '--ppi', '144', '--ignore-system-fonts', '--font-path', fonts, '-', png], { input: typst() });
  mkdirSync(new URL('.', OUT), { recursive: true });
  writeFileSync(OUT, writeDiagramXml(new Uint8Array(readFileSync(png)), xml()));
} finally {
  rmSync(dir, { recursive: true, force: true });
}
