#!/usr/bin/env node
//MISE description="Write the advanced demo example's spreadsheet (data/compile-times.ic) and its Typst file (.ic.gen.typ)"
//MISE sources=["mise-tasks/fixtures/demo-spreadsheet", "src/extensions/spreadsheets/model/typst-file.ts"]
//MISE outputs=["demo/examples/advanced/data/compile-times.ic", "demo/examples/advanced/data/compile-times.ic.gen.typ"]
// The demo opens .ic files in IronCalc's workbook UI; this builds one with IronCalc's engine, so the example
// file is reproducible instead of a binary nobody can regenerate. Its Typst file is what the widget writes on
// every edit (spreadsheetTypst), so the example compiles before anyone opened the spreadsheet.
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import init, { Model } from '@ironcalc/wasm';
import { spreadsheetTypst, typstPath } from '../../src/extensions/spreadsheets/model/typst-file.ts';

const NAME = 'compile-times.ic';
const DIR = new URL('../../demo/examples/advanced/data/', import.meta.url);

/** Cold compile times (ms) of three runs per document size; made up, like the rest of the example. */
const RUNS = [
  [1, 17, 18, 19],
  [10, 92, 95, 99],
  [50, 401, 410, 423],
  [100, 806, 820, 851],
];

await init({ module_or_path: readFileSync(new URL('../../node_modules/@ironcalc/wasm/wasm_bg.wasm', import.meta.url)) });
const model = new Model('compile-times', 'en', 'UTC', 'en');
model.renameSheet(0, 'Runs');
const header = ['Pages', 'Run 1', 'Run 2', 'Run 3', 'Median'];
header.forEach((title, index) => model.setUserInput(0, 1, index + 1, title));
RUNS.forEach((values, index) => {
  const row = index + 2;
  values.forEach((value, column) => model.setUserInput(0, row, column + 1, String(value)));
  model.setUserInput(0, row, 5, `=MEDIAN(B${row}:D${row})`);
});
const all = { sheet: 0, row: 1, column: 1, width: header.length, height: RUNS.length + 1 };
model.updateRangeStyle({ ...all, height: 1 }, 'font.b', 'true');
model.updateRangeStyle({ ...all, height: 1 }, 'fill.fg_color', '#E8EEF7');
model.updateRangeStyle({ ...all, column: 5, width: 1 }, 'font.b', 'true');
model.setColumnsWidth(0, 1, header.length, 80);
model.evaluate();

mkdirSync(DIR, { recursive: true });
writeFileSync(new URL(NAME, DIR), model.toBytes());
writeFileSync(new URL(typstPath(NAME), DIR), spreadsheetTypst(model, NAME));
