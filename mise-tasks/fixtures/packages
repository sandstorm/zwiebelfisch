#!/usr/bin/env bash
#MISE description="Pack the test package fixtures (src/**/fixtures/<name>-<version>/, next to the tests using them) into .tar.gz like packages.typst.org serves them"
#MISE sources=["src/**/fixtures/*/typst.toml", "src/**/fixtures/*/**"]
#MISE outputs=["src/**/fixtures/*.tar.gz"]
set -euo pipefail
# every package folder (it has a typst.toml) in a fixtures/ folder under src/
find src -path '*/fixtures/*/typst.toml' -not -path '*/node_modules/*' | while read -r manifest; do
  dir=$(dirname "$manifest")
  # pax format: paths over 100 bytes become pax headers, as in real archives
  COPYFILE_DISABLE=1 tar --format pax -czf "$dir.tar.gz" -C "$dir" .
done
