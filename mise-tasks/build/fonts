#!/usr/bin/env node
//MISE description="Copy the default fonts (Typst's typst-assets set) into src/core/typst-engine/fonts.gen and write their index (index.json)"
//MISE depends=["build:engine"]
//MISE sources=["crates/typst-engine/Cargo.lock", "src/core/typst-engine/wasm.gen/typst_engine_bg.wasm", "mise-tasks/build/fonts"]
//MISE outputs=["src/core/typst-engine/fonts.gen/LibertinusSerif-Regular.otf", "src/core/typst-engine/fonts.gen/index.json"]
// Exactly the fonts the Typst CLI of the version Cargo.lock pins embeds, plus the PDF base-14 substitutes (.pfb).
// index.json lists every face's FontInfo as the engine computes it, so the engine knows the fonts before it loads
// any: { "<file name>": FontInfo[] }, files sorted by name.
import { execFileSync } from 'node:child_process';
import { copyFileSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import init, { describeFont } from '../../src/core/typst-engine/wasm.gen/typst_engine.js';

const TARGET = 'src/core/typst-engine/fonts.gen';

const metadata = JSON.parse(
  execFileSync(
    'cargo',
    ['metadata', '--manifest-path', 'crates/typst-engine/Cargo.toml', '--format-version', '1', '--locked',
      '--filter-platform', 'wasm32-unknown-unknown'],
    { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 },
  ),
);
const assets = metadata.packages.find((p) => p.name === 'typst-assets');
const source = join(dirname(assets.manifest_path), 'files', 'fonts');
const names = readdirSync(source).filter((name) => /\.(otf|ttf)$/.test(name)).sort();

rmSync(TARGET, { recursive: true, force: true });
mkdirSync(TARGET, { recursive: true });
await init({ module_or_path: readFileSync('src/core/typst-engine/wasm.gen/typst_engine_bg.wasm') });
const index = {};
let bytes = 0;
for (const name of names) {
  copyFileSync(join(source, name), join(TARGET, name));
  const data = readFileSync(join(TARGET, name));
  bytes += data.length;
  index[name] = JSON.parse(describeFont(data));
  if (index[name].length === 0) throw new Error(`${name}: no font faces`);
}
const json = JSON.stringify(index);
writeFileSync(join(TARGET, 'index.json'), json);
const kb = (n) => `${(n / 1024).toFixed(0)} KB`;
console.log(`fonts: ${names.length} files, ${kb(bytes)}; index.json ${kb(json.length)}`);
