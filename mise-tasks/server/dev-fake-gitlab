#!/usr/bin/env bash
#MISE description="Start the playground server alone: GitLab rooms against an in-memory fake GitLab (gitlab:demo/report@<branch>) and plain rooms; mise run demo also starts the demo"
set -euo pipefail
# plain rooms and guest links on unless ZWF_PLAIN_ROOMS / ZWF_GUESTS say otherwise: the demo's Collaborate mode
# and "Share with guests…" use them
ZWF_PLAIN_ROOMS="${ZWF_PLAIN_ROOMS:-1}" ZWF_GUESTS="${ZWF_GUESTS:-1}" exec go run ./server/cmd/fake-gitlab "$@"
