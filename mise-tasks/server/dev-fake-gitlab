#!/usr/bin/env bash
#MISE description="Start the playground server alone: GitLab rooms against an in-memory fake GitLab (gitlab:demo/report@<branch>) and plain rooms; mise run demo also starts the demo"
set -euo pipefail
# plain rooms on unless ZWF_PLAIN_ROOMS says otherwise: the demo's Collaborate mode uses them
ZWF_PLAIN_ROOMS="${ZWF_PLAIN_ROOMS:-1}" exec go run ./server/cmd/fake-gitlab "$@"
