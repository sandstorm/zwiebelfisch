#!/usr/bin/env bash
#MISE description="Vet and test the collaboration server (Go: unit tests, Yjs fixtures, the real HocuspocusProvider in-process)"
set -euo pipefail
# TestServerBinary and TestPlaygroundBinary also run the built binaries on ports; they skip where none can be bound.
