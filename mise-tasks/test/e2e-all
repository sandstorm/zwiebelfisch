#!/usr/bin/env bash
#MISE description="Run every end-to-end suite: all browsers, collaboration, GitLab (with and without auto-commit), docs editing; goes on after a failure, then lists the failed suites"
#MISE depends=["build", "build:lib"]
#USAGE arg "[browser]" help="Only this browser, in every suite (default: all)" default="all" {
#USAGE   choices "all" "chromium" "firefox" "webkit"
#USAGE }
set -uo pipefail
failed=()
run() {
  local name="$1"
  shift
  echo "=== $name"
  "$@" || failed+=("$name")
}
# each suite its own results folder (test-results/<suite>/), so a later suite does not wipe an earlier one's failures
run "test:e2e ($usage_browser)" mise run test:e2e "$usage_browser" -- --output=test-results/e2e
run "test:e2e-collab ($usage_browser)" mise run test:e2e-collab "$usage_browser" -- --output=test-results/collab
run "test:e2e-gitlab ($usage_browser)" mise run test:e2e-gitlab "$usage_browser" -- --output=test-results/gitlab
run "test:e2e-gitlab (auto-commit off)" env TYPST_GITLAB_AUTO_COMMIT=off mise run test:e2e-gitlab "$usage_browser" -- --grep "leave" --output=test-results/gitlab-auto-commit-off
run "test:e2e-docs ($usage_browser)" mise run test:e2e-docs "$usage_browser" -- --output=test-results/docs
if ((${#failed[@]})); then
  printf 'Failed: %s\n' "${failed[@]}"
  exit 1
fi
echo "All end-to-end suites passed."
