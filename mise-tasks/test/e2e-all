#!/usr/bin/env bash
#MISE description="Run every end-to-end suite: all browsers, collaboration, GitLab (with and without auto-commit), docs editing; goes on after a failure, then lists the failed suites"
#MISE depends=["build", "build:lib"]
#USAGE arg "[browser]" help="Only this browser, in every suite (default: all)" default="all" {
#USAGE   choices "all" "chromium" "firefox" "webkit"
#USAGE }
set -uo pipefail
failed=()
run() {
  local name="$1"
  shift
  echo "=== $name"
  "$@" || failed+=("$name")
}
run "test:e2e ($usage_browser)" mise run test:e2e "$usage_browser"
run "test:e2e-collab ($usage_browser)" mise run test:e2e-collab "$usage_browser"
run "test:e2e-gitlab ($usage_browser)" mise run test:e2e-gitlab "$usage_browser"
run "test:e2e-gitlab (auto-commit off)" env TYPST_GITLAB_AUTO_COMMIT=off mise run test:e2e-gitlab "$usage_browser" -- --grep "leave"
run "test:e2e-docs ($usage_browser)" mise run test:e2e-docs "$usage_browser"
if ((${#failed[@]})); then
  printf 'Failed: %s\n' "${failed[@]}"
  exit 1
fi
echo "All end-to-end suites passed."
