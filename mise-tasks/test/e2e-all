#!/usr/bin/env bash
#MISE description="Run every end-to-end suite: all browsers, collaboration, GitLab, docs editing; goes on after a failure, then lists the failed suites"
#MISE depends=["build", "build:packages", "server:build"]
#USAGE arg "[browser]" help="Only this browser, in every suite (default: all)" default="all" {
#USAGE   choices "all" "chromium" "firefox" "webkit"
#USAGE }
set -uo pipefail
source mise-tasks/test/playwright.sh
failed=()
# each suite its own results folder (test-results/<suite>/, its config's outputDir)
for suite in e2e collab gitlab docs; do
  config=playwright.$suite.config.ts
  [[ $suite == e2e ]] && config=playwright.config.ts
  echo "=== $suite ($usage_browser)"
  playwright_test "$config" "$@" || failed+=("$suite")
done
if ((${#failed[@]})); then
  printf 'Failed: %s\n' "${failed[@]}"
  exit 1
fi
echo "All end-to-end suites passed."
