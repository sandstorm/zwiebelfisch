#!/usr/bin/env bash
#MISE description="Run the docs-editing Playwright spec against the demo dev server, which Playwright starts (edits docs/10_getting-started/01_getting-started.typ, restores it)"
#MISE depends=["build:engine", "build:fonts"]
#USAGE arg "[browser]" help="Only this browser (default: all)" default="all" {
#USAGE   choices "all" "chromium" "firefox" "webkit"
#USAGE }
#USAGE arg "[playwright_args]..." help="Passed on to Playwright (flags after --)" double_dash="automatic"
set -euo pipefail
source mise-tasks/test/playwright.sh
playwright_test playwright.docs.config.ts "$@"
