#!/usr/bin/env bash
#MISE description="Build the demo and the library, then run end-to-end tests (Playwright), in all browsers or one"
#MISE depends=["build", "build:packages"]
#USAGE arg "[browser]" help="Only this browser (default: all)" default="all" {
#USAGE   choices "all" "chromium" "firefox" "webkit"
#USAGE }
#USAGE arg "[playwright_args]..." help="Passed on to Playwright (spec files; flags after --)" double_dash="automatic"
set -euo pipefail
# e.g. `mise run test:e2e firefox tests/e2e/visual-figures.spec.ts`, `mise run test:e2e all -- --grep figure`
source mise-tasks/test/playwright.sh
playwright_test playwright.config.ts "$@"
