#!/usr/bin/env bash
#MISE description="Run the two-user Playwright spec against the playground server (in-memory, plain rooms, sign-in at its fake GitLab; the demo build on :5199), which Playwright starts"
#MISE depends=["build", "server:build"]
#USAGE arg "[browser]" help="Only this browser (default: all)" default="all" {
#USAGE   choices "all" "chromium" "firefox" "webkit"
#USAGE }
#USAGE arg "[playwright_args]..." help="Passed on to Playwright (flags after --)" double_dash="automatic"
set -euo pipefail
source mise-tasks/test/playwright.sh
playwright_test playwright.collab.config.ts "$@"
