#!/usr/bin/env bash
#MISE description="Start the playground server (in-memory, plain rooms, sign-in at its fake GitLab; the demo build on :5199) and run the two-user Playwright spec"
#MISE depends=["build", "server:build"]
#USAGE arg "[browser]" help="Only this browser (default: all)" default="all" {
#USAGE   choices "all" "chromium" "firefox" "webkit"
#USAGE }
#USAGE arg "[playwright_args]..." help="Passed on to Playwright (flags after --)" double_dash="automatic"
set -euo pipefail
# the browser choice as Playwright's --project, the rest passed on (as in test:e2e)
args=("$@")
[[ ${#args[@]} -gt 0 && "${args[0]}" == "$usage_browser" ]] && args=(${args[@]+"${args[@]:1}"})
[[ "$usage_browser" != all ]] && args=(--project="$usage_browser" ${args[@]+"${args[@]}"})
# the playground server: its fake GitLab signs the users in (zwiebelfisch needs a real provider). The demo build
# on :5199 (ZWF_DEMO_DIST), same host as the server, so the session cookie goes along.
ZWF_PLAIN_ROOMS=1 ZWF_DEMO_DIST=dist/demo .cache/bin/fake-gitlab &
server=$!
trap 'kill "$server"' EXIT
# wait until the server accepts connections (up to 10 s)
for _ in $(seq 100); do
  if (exec 3<>/dev/tcp/127.0.0.1/1234) 2>/dev/null; then break; fi
  sleep 0.1
done
ZWF_COLLAB_E2E=1 pnpm exec playwright test tests/e2e/collab.spec.ts ${args[@]+"${args[@]}"}
