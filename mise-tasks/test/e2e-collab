#!/usr/bin/env bash
#MISE description="Start the collaboration server (in-memory) and run the two-user Playwright spec against the demo build"
#MISE depends=["build"]
set -euo pipefail
TYPST_COLLAB_DB=":memory:" node server/src/main.ts &
server=$!
trap 'kill "$server"' EXIT
# wait until the server accepts connections (up to 10 s)
for _ in $(seq 100); do
  if (exec 3<>/dev/tcp/127.0.0.1/1234) 2>/dev/null; then break; fi
  sleep 0.1
done
TYPST_COLLAB_E2E=1 pnpm exec playwright test tests/e2e/collab.spec.ts "$@"
