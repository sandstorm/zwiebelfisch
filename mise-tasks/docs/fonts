#!/usr/bin/env bash
#MISE description="Download the docs' font (sandstorm.de's Gabarito, pinned and checksummed) into docs/fonts/"
#MISE outputs=["docs/fonts/Gabarito-Regular.ttf", "docs/fonts/Gabarito-SemiBold.ttf", "docs/fonts/Gabarito-Bold.ttf"]
# Static TTFs from Google Fonts (SIL Open Font License 1.1). Not in git. docs:pdf hands them to
# Typst (--font-path) and switches them on (--input brand-fonts=true); without that, e.g. in the
# demo, the book uses Typst's default fonts. docs:html copies them next to style.css.
# Code stays in DejaVu Sans Mono: the site's Ubuntu Mono lacks box-drawing characters.
set -euo pipefail
mkdir -p docs/fonts
fetch() { # file sha256 url
  local file="docs/fonts/$1"
  if [ -f "$file" ] && echo "$2  $file" | shasum -a 256 -c --status; then return; fi
  curl -sSfL -o "$file" "$3"
  echo "$2  $file" | shasum -a 256 -c --quiet
}
fetch Gabarito-Regular.ttf a936de73165607d73d690ca6861a7b1c79cf67b6e5bd590a7b4bdedd60662cd8 \
  https://fonts.gstatic.com/s/gabarito/v9/QGYwz_0dZAGKJJ4t3FFkc3Q8AkNP9Pj248K0Fg.ttf
fetch Gabarito-SemiBold.ttf a24daa060144f2631f6fdf1a73dc2eeaa08537dd09b7c36cfde3e4e1456327ac \
  https://fonts.gstatic.com/s/gabarito/v9/QGYwz_0dZAGKJJ4t3FFkc3Q8AkNP9Pj2PcW0Fg.ttf
fetch Gabarito-Bold.ttf 2f93a2dacd279c2206c74adbcba17db99e540bd1b4faae3fc166c6a42480da08 \
  https://fonts.gstatic.com/s/gabarito/v9/QGYwz_0dZAGKJJ4t3FFkc3Q8AkNP9Pj2BMW0Fg.ttf
echo "fonts: docs/fonts/"
