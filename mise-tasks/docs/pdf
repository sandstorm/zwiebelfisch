#!/usr/bin/env bash
#MISE description="Build the documentation book (docs/main.typ) as dist/docs/zwiebelfisch.pdf"
#MISE sources=["docs/**/*.typ", "src/hosts/*/*.ts", "docs/diagrams/*.mmd", "docs/assets/**/*", "docs/fonts/*.ttf"]
#MISE outputs=["dist/docs/zwiebelfisch.pdf"]
set -euo pipefail
mkdir -p dist/docs
typst compile --root . --font-path docs/fonts docs/main.typ dist/docs/zwiebelfisch.pdf "$@"
echo "docs: dist/docs/zwiebelfisch.pdf"
