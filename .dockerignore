**/target
dist
.cache
.claude
.git
.idea
test-results
playwright-report
src/core/typst-engine/wasm.gen
src/core/typst-engine/fonts.gen
server/.data
.env
mise.local.toml
**/*.log
**/.DS_Store
.github
