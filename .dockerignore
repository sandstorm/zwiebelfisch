# What the image must never contain (Dockerfile): dependencies, build output but the app (dist/app), caches, local secrets.
**/node_modules
**/target
dist/*
!dist/app
.cache
.claude
.git
.idea
test-results
playwright-report
src/core/typst-engine/wasm.gen
src/core/typst-engine/fonts.gen
server/.data
.env
mise.local.toml
**/*.log
**/.DS_Store
.github
