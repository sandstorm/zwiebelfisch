flowchart TD
  visual["`VisualEditor (Tiptap)
  keystroke → ProseMirror transaction`"]
  document["`TypstDocument.change(changes, visualEditor)
  onDidChange({ contentChanges, origin }):
  listeners in subscription order`"]
  project["Project"]
  workbench["Workbench"]
  worker["`worker
  compile (newest only) → changed pages swapped`"]
  host["host"]
  source["SourceEditor"]
  binding["`TextBinding
  (collaboration)`"]
  visual -- "`typstChanges(tr): one minimal TextChange
  per textblock touched`" --> document
  document -- 1 --> project
  document -. "`2: origin is itself, ignored`" .-> visual
  document -- "`3: dispatched with
  fromDocument({ origin })`" --> source
  document -- "`4: into the shared Y.Text`" --> binding
  project -- "`onDidChangeFile({ kind: 'update', … })`" --> workbench
  project -- onDidChangeFiles --> host
  workbench -- "`preview.update(project.files(), main)`" --> worker
